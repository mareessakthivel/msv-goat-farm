---
import { ArrowRight, Camera, Check, MapPin } from 'lucide-astro';
import WhatsAppButton from '../common/WhatsAppButton.astro';

export interface Props {
  name: string;
  tamilName?: string;
  categoryLabel?: string;
  locationLabel?: string;
  description: string;
  summaryIntro?: string;
  highlights?: string[];
  href: string;
  exploreLabel?: string;
  enquiryLabel: string;
  whatsappNumber: string;
  whatsappMessage: string;
  imageSrc?: string;
  imageAlt: string;
  placeholderLabel?: string;
  wideOnTablet?: boolean;
  showExtended?: boolean;
}

const {
  name,
  tamilName,
  categoryLabel,
  locationLabel,
  description,
  summaryIntro,
  highlights = [],
  href,
  exploreLabel = 'Explore Details',
  enquiryLabel,
  whatsappNumber,
  whatsappMessage,
  imageSrc,
  imageAlt,
  placeholderLabel,
  wideOnTablet = false,
  showExtended = false,
} = Astro.props;

const imageSrc800 = imageSrc ? imageSrc.replace(/\.webp$/, '-800.webp') : undefined;
---

<article
  class:list={[
    'brand-card min-w-0 group flex flex-col overflow-hidden rounded-[1.25rem] bg-white border border-[#43563A]/10 shadow-[0_10px_30px_-10px_rgba(67,86,58,0.11)] transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-[0_18px_40px_-12px_rgba(67,140,56,0.18)]',
    wideOnTablet && 'md:col-span-2 md:flex-row lg:col-span-1 lg:flex-col',
  ]}
>
  <div
    class:list={[
      'relative aspect-[4/3] w-full overflow-hidden bg-[#F4FBE9]',
      wideOnTablet && 'md:w-1/2 md:shrink-0 lg:w-full',
    ]}
  >
    {
      imageSrc ? (
        <img
          src={imageSrc}
          srcset={imageSrc800 ? `${imageSrc800} 800w, ${imageSrc} 1200w` : undefined}
          sizes={
            wideOnTablet
              ? '(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 33vw'
              : '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw'
          }
          alt={imageAlt}
          width="1200"
          height="900"
          loading="lazy"
          decoding="async"
          class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        />
      ) : (
        <div class="flex size-full flex-col items-center justify-center gap-3 bg-gradient-to-br from-[#F4FBE9] via-[#FFFDF4] to-[#FFF1D5] p-6 text-center">
          <span class="inline-flex size-12 items-center justify-center rounded-full bg-white text-[#438C38] shadow-sm ring-1 ring-[#63A83E]/20">
            <Camera class="size-5" aria-hidden="true" />
          </span>
          <div class="space-y-1">
            <p class="m-0 font-heading text-base font-bold text-[#43563A]">
              {name}
              {tamilName && (
                <span lang="ta" class="block text-sm font-semibold text-[#438C38]">
                  {tamilName}
                </span>
              )}
            </p>
            <p class="m-0 text-xs font-medium text-[#58684C]">
              {placeholderLabel ?? 'Product visual'}
            </p>
          </div>
        </div>
      )
    }

    {
      categoryLabel && (
        <span class="absolute left-3 top-3 inline-flex rounded-full bg-[#FFFDF4]/95 px-3 py-1 text-[11px] font-heading font-bold uppercase tracking-wider text-[#438C38] shadow-sm ring-1 ring-[#43563A]/10 backdrop-blur-sm">
          {categoryLabel}
        </span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col justify-between p-6">
    <div>
      {
        locationLabel && (
          <p class="m-0 mb-1.5 inline-flex items-center gap-1 text-xs font-medium text-[#58684C]">
            <MapPin class="size-3.5 text-[#438C38]" aria-hidden="true" />
            <span>{locationLabel}</span>
          </p>
        )
      }

      <div class="mb-2.5 flex flex-wrap items-baseline gap-2">
        <h3 class="m-0 font-heading text-xl font-bold text-[#43563A]">{name}</h3>
        {
          tamilName && (
            <span
              lang="ta"
              class="rounded-full bg-[#FFF1D5] px-2.5 py-0.5 text-xs font-semibold text-[#43563A]"
            >
              {tamilName}
            </span>
          )
        }
      </div>

      <p class="m-0 text-[0.9375rem] leading-relaxed text-[#58684C]">
        {description}
      </p>

      {
        showExtended && summaryIntro && (
          <p class="m-0 mt-2.5 text-sm leading-relaxed text-[#58684C]">
            {summaryIntro}
          </p>
        )
      }

      {
        highlights.length > 0 && (
          <ul class="m-0 mt-4 mb-5 list-none space-y-1.5 p-0 text-xs sm:text-[0.8125rem] text-[#43563A]">
            {highlights.map((item) => (
              <li class="flex items-start gap-2">
                <Check class="mt-0.5 size-3.5 shrink-0 text-[#438C38]" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="flex flex-wrap items-center gap-3 pt-4 border-t border-[#43563A]/8">
      <a
        href={href}
        class="inline-flex min-h-[44px] flex-1 sm:flex-initial items-center justify-center gap-1.5 rounded-full border border-[#438C38]/30 bg-[#F4FBE9] px-4 py-2 text-sm font-heading font-bold text-[#43563A] no-underline transition-colors hover:border-[#438C38] hover:bg-[#E7F6D3]"
      >
        <span>{exploreLabel}</span>
        <ArrowRight class="size-4 shrink-0 text-[#438C38]" aria-hidden="true" />
      </a>
      <WhatsAppButton
        phoneNumber={whatsappNumber}
        message={whatsappMessage}
        label={enquiryLabel}
        variant="primary"
        size="sm"
        class="flex-1 sm:flex-initial"
      />
    </div>
  </div>
</article>
