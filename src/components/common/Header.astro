---
import {
  Droplets,
  Flame,
  Home,
  Images,
  Info,
  MapPin,
  Menu,
  MessageCircle,
  Package,
  Phone,
  PhoneCall,
  Sprout,
  ChevronRight,
  X,
} from 'lucide-astro';
import { buildPhoneHref, buildWhatsAppUrl } from '../../utils/whatsapp';

export interface NavLink {
  label: string;
  href: string;
}

export interface Props {
  businessName: string;
  locationShort: string;
  navLinks: NavLink[];
  whatsappNumber: string;
  phoneDisplay?: string;
  phoneConfirmed?: boolean;
  currentPath?: string;
}

const {
  businessName,
  locationShort,
  navLinks,
  whatsappNumber,
  phoneDisplay = '',
  phoneConfirmed = false,
  currentPath = '/',
} = Astro.props;

const waHref = buildWhatsAppUrl({
  phoneNumber: whatsappNumber,
  message: 'Hello MSV Goat Farm, I would like to enquire about your farm products in Theni.',
});

const phoneHref = phoneConfirmed && phoneDisplay ? buildPhoneHref(phoneDisplay) : null;

const getNavIcon = (href: string) => {
  switch (href) {
    case '/':
      return Home;
    case '/products/':
      return Package;
    case '/live-goats-for-sale-theni/':
      return Sprout;
    case '/uppukandam-theni/':
      return Flame;
    case '/goat-milk-theni/':
      return Droplets;
    case '/about/':
      return Info;
    case '/gallery/':
      return Images;
    case '/contact/':
      return PhoneCall;
    default:
      return ChevronRight;
  }
};
---

<header class="site-header sticky top-0 z-40 border-b border-[#43563A]/10 bg-[#FFFDF4]/95 backdrop-blur-md">
  <div class="header-inner mx-auto flex max-w-[78rem] items-center justify-between gap-4 px-4 py-2.5 sm:px-6 lg:px-8">
    <a
      href="/"
      class="site-logo inline-flex items-center gap-3 no-underline shrink-0 group"
      aria-label={`${businessName} Home`}
    >
      <span class="inline-flex size-12 sm:size-14 items-center justify-center rounded-full bg-white p-1 shadow-[0_4px_12px_-4px_rgba(67,86,58,0.18)] ring-1 ring-[#63A83E]/25">
        <img
          src="/images/logo/msv-goat-farm-logo.webp"
          alt="MSV Goat Farm official emblem logo"
          width="56"
          height="56"
          class="size-full object-contain"
          loading="eager"
          decoding="async"
        />
      </span>
      <span class="flex flex-col leading-tight">
        <span class="font-heading text-base sm:text-lg font-extrabold tracking-tight text-[#43563A] group-hover:text-[#438C38] transition-colors">
          {businessName}
        </span>
        <span class="text-xs font-medium text-[#58684C]">
          {locationShort}
        </span>
      </span>
    </a>

    <nav class="site-nav flex items-center gap-3" aria-label="Primary">
      <button
        class="menu-button inline-flex min-h-[44px] items-center gap-2 rounded-full border border-[#438C38]/25 bg-white px-4 py-2 font-heading text-sm font-bold text-[#43563A] shadow-sm transition-colors hover:bg-[#F4FBE9] cursor-pointer"
        type="button"
        popovertarget="site-menu"
        popovertargetaction="toggle"
        aria-controls="site-menu"
        aria-expanded="false"
      >
        <Menu class="size-4 shrink-0 text-[#438C38]" aria-hidden="true" />
        <span>Menu</span>
      </button>

      <ul id="site-menu" class="site-menu list-none m-0" popover="auto">
        <!-- Mobile Sidebar Header -->
        <li class="drawer-header">
          <div class="flex items-center gap-2.5 min-w-0">
            <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-[#FFFDF4] p-1 ring-1 ring-[#63A83E]/30 shadow-sm">
              <img
                src="/images/logo/msv-goat-farm-logo.webp"
                alt=""
                width="36"
                height="36"
                class="size-full object-contain"
                loading="lazy"
                decoding="async"
                aria-hidden="true"
              />
            </span>
            <div class="min-w-0">
              <p class="m-0 truncate font-heading text-sm font-extrabold text-[#43563A]">
                {businessName}
              </p>
              <p class="m-0 inline-flex items-center gap-1 text-[11px] font-medium text-[#58684C]">
                <MapPin class="size-3 shrink-0 text-[#438C38]" aria-hidden="true" />
                <span class="truncate">{locationShort}</span>
              </p>
            </div>
          </div>

          <button
            type="button"
            class="drawer-close-btn inline-flex size-11 shrink-0 items-center justify-center rounded-full border border-[#43563A]/15 bg-[#FFFDF4] text-[#43563A] transition-colors hover:bg-[#F4FBE9] hover:text-[#438C38] cursor-pointer"
            data-drawer-close
            aria-label="Close navigation menu"
          >
            <X class="size-4" aria-hidden="true" />
          </button>
        </li>

        <li class="drawer-section-label" aria-hidden="true">
          <span>Menu &amp; Pages</span>
        </li>

        {
          navLinks.map((link, idx) => {
            const isCurrent =
              link.href === '/' ? currentPath === '/' : currentPath === link.href;
            const Icon = getNavIcon(link.href);
            return (
              <li class="nav-item" style={`--item-i: ${idx};`}>
                <a
                  href={link.href}
                  aria-current={isCurrent ? 'page' : undefined}
                  class="nav-link group inline-flex min-h-[44px] items-center justify-between gap-3 rounded-2xl px-3.5 py-2.5 text-[0.9375rem] font-semibold text-[#43563A] no-underline transition-colors hover:bg-[#F4FBE9] hover:text-[#438C38]"
                >
                  <span class="inline-flex items-center gap-3 min-w-0">
                    <span class="drawer-item-icon inline-flex size-8 shrink-0 items-center justify-center rounded-xl bg-[#F4FBE9] text-[#438C38] ring-1 ring-[#63A83E]/15 transition-colors group-hover:bg-white">
                      <Icon class="size-4" aria-hidden="true" />
                    </span>
                    <span class="truncate">{link.label}</span>
                  </span>
                  <ChevronRight
                    class="drawer-item-arrow size-4 shrink-0 text-[#58684C]/60 transition-transform group-hover:translate-x-0.5 group-hover:text-[#438C38]"
                    aria-hidden="true"
                  />
                </a>
              </li>
            );
          })
        }

        <!-- Mobile Sidebar Action Footer / Desktop Inline WhatsApp CTA -->
        <li class="nav-cta-item">
          <div class="drawer-cta-stack">
            <a
              href={waHref}
              target="_blank"
              rel="noopener noreferrer"
              class="wa-pill-cta inline-flex min-h-[44px] w-full items-center justify-center gap-2 rounded-full bg-primary-gradient px-4 py-2 font-heading text-sm font-bold text-white no-underline shadow-[0_8px_18px_-6px_rgba(67,140,56,0.55)] transition hover:brightness-95"
            >
              <MessageCircle class="size-4 shrink-0" aria-hidden="true" />
              <span>WhatsApp</span>
            </a>

            {
              phoneHref && (
                <a
                  href={phoneHref}
                  class="drawer-call-cta inline-flex min-h-[44px] w-full items-center justify-center gap-2 rounded-full bg-gold-gradient px-4 py-2 font-heading text-sm font-bold text-[#43563A] no-underline border border-[#E5B83E]/50 shadow-sm transition hover:brightness-95"
                >
                  <Phone class="size-4 shrink-0" aria-hidden="true" />
                  <span>Call {phoneDisplay}</span>
                </a>
              )
            }
          </div>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style is:global>
  .site-header .header-inner > * {
    flex-shrink: 0;
    white-space: nowrap;
  }

  /* =====================================================================
     NARROW / MOBILE VIEWPORT: Modern Animated Slide-In Side Drawer
     ===================================================================== */
  .site-header:not(.is-wide) .site-menu {
    position: fixed;
    inset-block: 0;
    inset-inline-start: auto;
    inset-inline-end: 0;
    inline-size: min(86dvw, 22.5rem);
    max-inline-size: calc(100dvw - 1.75rem);
    block-size: 100dvh;
    max-block-size: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    border-inline-start: 1px solid rgba(67, 86, 58, 0.14);
    border-radius: 1.5rem 0 0 1.5rem;
    background: linear-gradient(180deg, #FFFDF4 0%, #FFFFFF 38%, #F4FBE9 100%);
    box-shadow: -16px 0 44px -10px rgba(45, 62, 39, 0.28);
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;

    display: flex;
    flex-direction: column;
    gap: 0.25rem;

    opacity: 0;
    transition-property: opacity, translate, display, overlay;
    transition-duration: 0.3s;
    transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    transition-behavior: allow-discrete;
  }

  .site-header:not(.is-wide) .site-menu:not(:is(:popover-open, .\:popover-open)) {
    display: none;
  }

  .site-header:not(.is-wide) .site-menu::backdrop {
    background-color: rgba(34, 48, 29, 0);
    backdrop-filter: blur(0px);
    transition-property: background-color, backdrop-filter, display, overlay;
    transition-duration: 0.3s;
    transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    transition-behavior: allow-discrete;
  }

  .site-header:not(.is-wide) .site-menu:is(:popover-open, .\:popover-open):where(:not([data-closing])) {
    display: flex;
    opacity: 1;

    @starting-style {
      opacity: 0;
    }

    &::backdrop {
      background-color: rgba(34, 48, 29, 0.48);
      backdrop-filter: blur(4px);

      @starting-style {
        background-color: rgba(34, 48, 29, 0);
        backdrop-filter: blur(0px);
      }
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header:not(.is-wide) .site-menu {
      translate: 100% 0;
    }

    .site-header:not(.is-wide) .site-menu:is(:popover-open, .\:popover-open):where(:not([data-closing])) {
      translate: 0 0;

      @starting-style {
        translate: 100% 0;
      }
    }

    /* Subtle staggered entrance for sidebar links */
    .site-header:not(.is-wide) .site-menu .nav-item {
      opacity: 0;
      translate: 14px 0;
      transition:
        opacity 0.28s cubic-bezier(0.22, 1, 0.36, 1),
        translate 0.32s cubic-bezier(0.22, 1, 0.36, 1);
      transition-delay: calc(var(--item-i, 0) * 32ms + 60ms);
    }

    .site-header:not(.is-wide) .site-menu:is(:popover-open, .\:popover-open):where(:not([data-closing])) .nav-item {
      opacity: 1;
      translate: 0 0;

      @starting-style {
        opacity: 0;
        translate: 14px 0;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header:not(.is-wide) .site-menu,
    .site-header:not(.is-wide) .site-menu::backdrop {
      transition-duration: 0.12s;
    }
  }

  /* Drawer internal regions (narrow) */
  .site-header:not(.is-wide) .drawer-header {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 1.125rem;
    background: rgba(255, 253, 244, 0.94);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(67, 86, 58, 0.1);
  }

  .site-header:not(.is-wide) .drawer-section-label {
    padding: 0.625rem 1.25rem 0.25rem;
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #58684C;
  }

  .site-header:not(.is-wide) .nav-item {
    padding-inline: 0.75rem;
  }

  .site-header:not(.is-wide) .site-menu .nav-link {
    width: 100%;
    border: 1px solid transparent;
  }

  .site-header:not(.is-wide) .site-menu .nav-link[aria-current='page'] {
    background-color: #F4FBE9;
    border-color: rgba(67, 140, 56, 0.28);
    color: #438C38;
    font-weight: 700;
    box-shadow: inset 4px 0 0 0 #438C38;
  }

  .site-header:not(.is-wide) .site-menu .nav-link[aria-current='page'] .drawer-item-icon {
    background-color: #438C38;
    color: #FFFFFF;
  }

  .site-header:not(.is-wide) .nav-cta-item {
    position: sticky;
    bottom: 0;
    z-index: 2;
    margin-block-start: auto;
    padding: 0.875rem 1rem 1.125rem;
    background: linear-gradient(180deg, rgba(244, 251, 233, 0.85) 0%, #F4FBE9 28%);
    backdrop-filter: blur(8px);
    border-top: 1px solid rgba(67, 86, 58, 0.1);
  }

  .site-header:not(.is-wide) .drawer-cta-stack {
    display: grid;
    gap: 0.5rem;
  }

  /* =====================================================================
     WIDE / DESKTOP VIEWPORT: Crisp Single-Row Inline Navigation
     ===================================================================== */
  .site-header.is-wide .menu-button,
  .site-header.is-wide .drawer-header,
  .site-header.is-wide .drawer-section-label,
  .site-header.is-wide .drawer-item-icon,
  .site-header.is-wide .drawer-item-arrow,
  .site-header.is-wide .drawer-call-cta {
    display: none;
  }

  .site-header.is-wide .site-menu {
    position: static;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    inline-size: auto;
    max-inline-size: none;
    block-size: auto;
    max-block-size: none;
    overflow: visible;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    opacity: 1;
    translate: none;
    transition: none;
  }

  .site-header.is-wide .site-menu .nav-link {
    width: auto;
    justify-content: center;
    border-radius: 9999px;
    padding: 0.5rem 0.875rem;
  }

  .site-header.is-wide .site-menu .nav-link[aria-current='page'] {
    background-color: #F4FBE9;
    color: #438C38;
    box-shadow: inset 0 -2px 0 0 #438C38;
  }

  .site-header.is-wide .site-menu .nav-cta-item {
    padding-block-start: 0;
    margin-inline-start: 0.375rem;
  }

  .site-header.is-wide .drawer-cta-stack {
    display: flex;
    align-items: center;
  }

  .site-header.is-wide .site-menu::backdrop {
    display: none;
  }

  .site-header.is-measuring *,
  .site-header.is-measuring .site-menu {
    transition: none !important;
    transition-delay: 0ms !important;
  }

  .site-header.is-measuring .header-inner {
    overflow: hidden;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const inner = header?.querySelector<HTMLElement>('.header-inner');
  const menu = header?.querySelector<HTMLElement>('#site-menu');
  const menuButton = header?.querySelector<HTMLButtonElement>('.menu-button');
  const closeButton = menu?.querySelector<HTMLButtonElement>('[data-drawer-close]');

  if (header && inner && menu) {
    let lastWidth = inner.clientWidth;
    let supportsDisplayTransition: boolean | undefined;

    const canTransitionDisplay = (): boolean => {
      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
      if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
        return false;
      }
      const probe = document.createElement('div');
      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
      document.body.appendChild(probe);
      getComputedStyle(probe).display;
      probe.style.display = 'none';
      supportsDisplayTransition = getComputedStyle(probe).display === 'block';
      probe.remove();
      return supportsDisplayTransition;
    };

    const supportsTopLayerExit = (): boolean =>
      Boolean(window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay());

    const closeDrawerCleanly = async () => {
      if (
        header.classList.contains('is-wide') ||
        !menu.matches(':popover-open') ||
        menu.hasAttribute('data-closing')
      ) {
        return;
      }

      if (!supportsTopLayerExit()) {
        menu.setAttribute('data-closing', '');
        const animations = menu.getAnimations({ subtree: true });
        if (animations.length > 0) {
          await Promise.race([
            Promise.allSettled(animations.map((a) => a.finished)),
            new Promise((resolve) => setTimeout(resolve, 600)),
          ]);
        }
        if (!menu.hasAttribute('data-closing')) return;
        menu.removeAttribute('data-closing');
      }

      if (typeof menu.hidePopover === 'function') {
        try {
          menu.hidePopover();
        } catch {
          // Ignore if already hidden
        }
      }
    };

    // Sync aria-expanded and remove any stale closing flag when opening
    menu.addEventListener('toggle', (event) => {
      const toggleEvent = event as ToggleEvent;
      const isOpen = toggleEvent.newState === 'open';
      menuButton?.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      if (isOpen) {
        menu.removeAttribute('data-closing');
      }
    });

    // Explicit animated close via X button
    closeButton?.addEventListener('click', () => {
      void closeDrawerCleanly();
    });

    // Animated close when clicking an anchor link inside narrow drawer
    menu.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      const anchor = target?.closest('a');
      if (anchor && !header.classList.contains('is-wide')) {
        void closeDrawerCleanly();
      }
    });

    // Swipe right gently on touchscreens to dismiss drawer
    let touchStartX = 0;
    let touchStartY = 0;
    menu.addEventListener(
      'touchstart',
      (e) => {
        if (header.classList.contains('is-wide') || e.touches.length !== 1) return;
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
      },
      { passive: true }
    );
    menu.addEventListener(
      'touchend',
      (e) => {
        if (header.classList.contains('is-wide') || e.changedTouches.length !== 1) return;
        const dx = e.changedTouches[0].clientX - touchStartX;
        const dy = Math.abs(e.changedTouches[0].clientY - touchStartY);
        if (dx > 64 && dy < 48) {
          void closeDrawerCleanly();
        }
      },
      { passive: true }
    );

    const updateNavLayout = (forceMeasure = false) => {
      const wasWide = header.classList.contains('is-wide');
      const currentWidth = inner.clientWidth;

      if (!wasWide && !forceMeasure && currentWidth <= lastWidth) {
        lastWidth = currentWidth;
        return;
      }

      const wasOpen =
        menu.matches(':popover-open') || menu.classList.contains(':popover-open');

      header.classList.add('is-measuring');
      header.classList.add('is-wide');
      menu.removeAttribute('popover');

      const fitsInline = inner.scrollWidth <= inner.clientWidth + 1;

      if (fitsInline) {
        header.classList.add('is-wide');
        menu.removeAttribute('popover');
        menuButton?.setAttribute('aria-expanded', 'false');
      } else {
        header.classList.remove('is-wide');
        menu.setAttribute('popover', 'auto');
        if (wasOpen && typeof menu.showPopover === 'function') {
          try {
            menu.showPopover();
          } catch {
            // Ignore if already open or unsupported
          }
        }
      }

      lastWidth = currentWidth;
      requestAnimationFrame(() => {
        header.classList.remove('is-measuring');
      });
    };

    const observer = new ResizeObserver(() => {
      updateNavLayout(false);
    });

    observer.observe(header);
    observer.observe(menu);
    updateNavLayout(true);
  }
</script>
