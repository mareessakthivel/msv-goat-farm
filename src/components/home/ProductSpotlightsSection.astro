---
import { Droplets, Flame } from 'lucide-astro';
import Section from '../common/Section.astro';
import WhatsAppButton from '../common/WhatsAppButton.astro';

export interface Props {
  whatsappNumber: string;
}

const { whatsappNumber } = Astro.props;
---

<Section id="specialty-products" surface="main" class="reveal-on-scroll">
  <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
    <article
      id="goat-milk-spotlight"
      class="brand-card min-w-0 flex flex-col justify-between rounded-[1.5rem] bg-[#F4FBE9] p-6 sm:p-8 ring-1 ring-[#63A83E]/20 shadow-[0_10px_28px_-10px_rgba(67,86,58,0.12)]"
    >
      <div class="space-y-4">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1 text-xs font-heading font-bold uppercase tracking-wider text-[#438C38]">
          <Droplets class="size-3.5" aria-hidden="true" />
          <span>Farm Dairy</span>
        </span>

        <figure class="m-0 overflow-hidden rounded-[1.125rem] bg-white p-1.5 shadow-sm ring-1 ring-[#43563A]/10">
          <img
            src="/images/goat-milk/msv-goat-milk-product.webp"
            srcset="/images/goat-milk/msv-goat-milk-product-800.webp 800w, /images/goat-milk/msv-goat-milk-product.webp 1200w"
            sizes="(max-width: 1024px) 100vw, 45vw"
            alt="Creamy white goat milk in an unbranded clear glass carafe and cup on a wooden table in a natural South Indian farm setting"
            width="1200"
            height="900"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full rounded-[0.875rem] object-cover"
          />
          <figcaption class="px-2 pt-2 pb-0.5 text-[11px] text-[#58684C]">
            Illustrative product photograph representing farm-sourced goat milk.
          </figcaption>
        </figure>

        <h2 class="m-0 font-heading text-2xl sm:text-3xl font-extrabold text-[#43563A]">
          Goat Milk in Theni
        </h2>

        <p class="m-0 text-base leading-relaxed text-[#58684C]">
          Enquire directly with MSV Goat Farm for goat milk availability in Theni. Current
          availability and enquiry details are confirmed directly with the farm owner on WhatsApp
          or by telephone.
        </p>
      </div>

      <div class="mt-6 pt-5 border-t border-[#43563A]/10 flex flex-wrap items-center gap-3">
        <WhatsAppButton
          phoneNumber={whatsappNumber}
          message="Hello MSV Goat Farm, I would like to enquire about goat milk availability in Theni."
          label="Enquire for Goat Milk"
          variant="primary"
        />
      </div>
    </article>

    <article
      id="uppukandam-spotlight"
      class="brand-card min-w-0 flex flex-col justify-between rounded-[1.5rem] bg-[#FFF1D5] p-6 sm:p-8 ring-1 ring-[#EFA45C]/35 shadow-[0_10px_28px_-10px_rgba(67,86,58,0.12)]"
    >
      <div class="space-y-4">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1 text-xs font-heading font-bold uppercase tracking-wider text-[#43563A]">
          <Flame class="size-3.5 text-[#EFA45C]" aria-hidden="true" />
          <span>Traditional Product</span>
        </span>

        <figure class="m-0 overflow-hidden rounded-[1.125rem] bg-white p-1.5 shadow-sm ring-1 ring-[#43563A]/10">
          <img
            src="/images/uppukandam/msv-traditional-uppukandam.webp"
            srcset="/images/uppukandam/msv-traditional-uppukandam-800.webp 800w, /images/uppukandam/msv-traditional-uppukandam.webp 1200w"
            sizes="(max-width: 1024px) 100vw, 45vw"
            alt="Traditional dried goat meat Uppukandam pieces served on a fresh green banana leaf in an earthen platter under warm natural daylight"
            width="1200"
            height="900"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full rounded-[0.875rem] object-cover"
          />
          <figcaption class="px-2 pt-2 pb-0.5 text-[11px] text-[#58684C]">
            Illustrative product photograph representing traditional dried goat meat (Uppukandam).
          </figcaption>
        </figure>

        <div class="space-y-1">
          <h2 class="m-0 font-heading text-2xl sm:text-3xl font-extrabold text-[#43563A]">
            Uppukandam (<span lang="ta">உப்புக்கண்டம்</span>)
          </h2>
        </div>

        <p class="m-0 text-base leading-relaxed text-[#58684C]">
          Traditional dried goat meat (<span lang="ta">உப்புக்கண்டம்</span>) offered through
          MSV Goat Farm in Theni. Reach out via WhatsApp or telephone to check current availability
          and enquiry details.
        </p>
      </div>

      <div class="mt-6 pt-5 border-t border-[#43563A]/10 flex flex-wrap items-center gap-3">
        <WhatsAppButton
          phoneNumber={whatsappNumber}
          message="Hello MSV Goat Farm, I would like to enquire about Uppukandam (உப்புக்கண்டம்) in Theni."
          label="Enquire for Uppukandam"
          variant="gold"
        />
      </div>
    </article>
  </div>
</Section>
