---
import { getCollection, getEntry } from 'astro:content';
import {
  ArrowRight,
  CheckCircle2,
  LayoutGrid,
  MapPin,
  MessageCircle,
  Phone,
  SunMedium,
  Utensils,
} from 'lucide-astro';
import { buildPhoneHref } from '../utils/whatsapp';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/common/PageHero.astro';
import Section from '../components/common/Section.astro';
import Button from '../components/common/Button.astro';
import WhatsAppButton from '../components/common/WhatsAppButton.astro';
import ContactCtaSection from '../components/home/ContactCtaSection.astro';

const siteSettings = await getEntry('settings', 'site');
const settings = siteSettings!.data;
const products = (await getCollection('products'))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);

const phoneHref = settings.contact.phoneConfirmed
  ? buildPhoneHref(settings.contact.phoneDisplay)
  : null;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/' },
];

const infrastructureCards = [
  {
    icon: LayoutGrid,
    title: 'Elevated Wooden & Slatted Flooring',
    text: 'Raised pens built with wooden planks and perforated green plastic slatted panels elevate goats off the ground so waste drops below the platform.',
  },
  {
    icon: SunMedium,
    title: 'Open-Sided Corrugated Roof & Netting',
    text: 'Steel truss roofing paired with perimeter green shade-netting and blue curtains provides shade and rain cover while allowing open cross-breeze.',
  },
  {
    icon: Utensils,
    title: 'Central Walkway & Aisle Feed Troughs',
    text: 'Tubular metal pen railings border a central wooden aisle lined with galvanized half-round troughs holding chopped green fodder.',
  },
];

const generalCarePrinciples = [
  'Keeping elevated floors dry and ventilated helps reduce dampness beneath hooves.',
  'Elevated aisle feed troughs help prevent goats from stepping on or soiling green fodder.',
  'Consistent airflow and shade-netted sides buffer heat inside enclosed stall-fed structures.',
  'Clean drinking water, spacing, and regular observation remain core principles of goat husbandry.',
];
---

<BaseLayout
  title="About MSV Goat Farm in Theni | Infrastructure & Operations Overview"
  description="About MSV Goat Farm in Theni, Tamil Nadu — elevated slatted-floor goat housing, wide wooden ramp, aisle feeding troughs, and our three confirmed farm offerings."
  ogImage="/images/farm/msv-elevated-shed-exterior-ramp.webp"
  heroPreloadImage="/images/farm/msv-elevated-shed-exterior-ramp.webp"
  breadcrumbs={breadcrumbs}
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="About MSV Goat Farm • Theni"
    title="Elevated-Shed Goat Farming in Theni, Tamil Nadu"
    description="MSV Goat Farm is a livestock farm in Theni operating with raised slatted-floor housing and three confirmed product categories: live goats for sale, traditional Uppukandam (உப்புக்கண்டம்), and goat milk."
  >
    <div slot="actions" class="flex flex-wrap items-center gap-3 pt-2">
      <Button href="/products/" variant="primary" size="lg">
        <span>Explore Products</span>
        <ArrowRight class="size-4 shrink-0" aria-hidden="true" />
      </Button>
      <WhatsAppButton
        phoneNumber={settings.contact.whatsappNumber}
        message="Hello MSV Goat Farm, I would like to learn more about your farm in Theni."
        label="Enquire on WhatsApp"
        variant="secondary"
        size="lg"
      />
      {
        phoneHref && (
          <Button href={phoneHref} variant="gold" size="lg">
            <Phone class="size-4 shrink-0" aria-hidden="true" />
            <span>Call {settings.contact.phoneDisplay}</span>
          </Button>
        )
      }
    </div>

    <figure
      slot="media"
      class="m-0 overflow-hidden rounded-[1.5rem] bg-white p-2 shadow-[0_18px_42px_-14px_rgba(67,86,58,0.18)] ring-1 ring-[#43563A]/10"
    >
      <img
        src="/images/farm/msv-elevated-shed-exterior-ramp.webp"
        srcset="/images/farm/msv-elevated-shed-exterior-ramp-800.webp 800w, /images/farm/msv-elevated-shed-exterior-ramp.webp 1200w"
        sizes="(max-width: 1024px) 100vw, 42vw"
        alt="Front exterior view of the elevated goat shed with wooden slatted ramp and metal railings in Theni"
        width="1200"
        height="900"
        fetchpriority="high"
        loading="eager"
        decoding="async"
        class="aspect-[4/3] w-full rounded-[1.125rem] object-cover"
      />
      <figcaption class="px-3 pt-2 pb-1 text-xs text-[#58684C]">
        Illustrative exterior visualization modeled on MSV Goat Farm&rsquo;s elevated shed and wooden access ramp in Theni.
      </figcaption>
    </figure>
  </PageHero>

  <Section surface="main">
    <div class="mx-auto mb-8 max-w-3xl text-center space-y-2.5">
      <span class="inline-flex items-center rounded-full bg-[#F4FBE9] px-3.5 py-1 text-xs font-heading font-bold uppercase tracking-wider text-[#438C38] ring-1 ring-[#63A83E]/25">
        Farm Overview &amp; Infrastructure
      </span>
      <h2 class="m-0 font-heading text-3xl font-extrabold text-[#43563A]">
        What Is Built at MSV Goat Farm in Theni
      </h2>
      <p class="m-0 text-sm sm:text-base text-[#58684C]">
        The farm sits in a rural compound bordered by green fodder and palm trees with hills in the
        distance. Visible farm structures follow an elevated stall-fed goat shed layout:
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        infrastructureCards.map((card) => {
          const Icon = card.icon;
          return (
            <article class="brand-card rounded-[1.25rem] bg-white p-6 ring-1 ring-[#43563A]/10 shadow-[0_10px_28px_-10px_rgba(67,86,58,0.10)]">
              <span class="inline-flex size-11 items-center justify-center rounded-xl bg-[#F4FBE9] text-[#438C38] mb-4">
                <Icon class="size-5" aria-hidden="true" />
              </span>
              <h3 class="m-0 font-heading text-xl font-bold text-[#43563A]">{card.title}</h3>
              <p class="m-0 mt-2 text-sm leading-relaxed text-[#58684C]">{card.text}</p>
            </article>
          );
        })
      }
    </div>
  </Section>

  <Section surface="soft-green">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="min-w-0 lg:col-span-6">
        <figure class="m-0 overflow-hidden rounded-[1.5rem] bg-white p-2 shadow-[0_14px_38px_-12px_rgba(67,86,58,0.16)] ring-1 ring-[#43563A]/10">
          <img
            src="/images/farm/msv-shed-interior-wooden-slats.webp"
            srcset="/images/farm/msv-shed-interior-wooden-slats-800.webp 800w, /images/farm/msv-shed-interior-wooden-slats.webp 1200w"
            sizes="(max-width: 1024px) 100vw, 50vw"
            alt="Interior central aisle of the elevated goat shed with wooden slatted floors and galvanized feeding troughs"
            width="1200"
            height="900"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full rounded-[1.125rem] object-cover"
          />
          <figcaption class="px-3 pt-2 pb-1 text-xs text-[#58684C]">
            Illustrative interior view of the raised wooden slatted deck, metal dividers, and aisle feeding troughs.
          </figcaption>
        </figure>
      </div>

      <div class="min-w-0 space-y-5 lg:col-span-6">
        <span class="inline-flex items-center rounded-full bg-white px-3.5 py-1 text-xs font-heading font-bold uppercase tracking-wider text-[#438C38] ring-1 ring-[#63A83E]/25">
          Feeding Setup &amp; Care Principles
        </span>
        <h2 class="m-0 font-heading text-3xl font-extrabold text-[#43563A]">
          Feeding Arrangement &amp; Goat Care Context
        </h2>
        <p class="m-0 text-sm sm:text-base leading-relaxed text-[#58684C]">
          Inside the shed, half-round metal troughs run along the central aisle so chopped green
          fodder is accessed through pen rails from raised slatted floors. These design choices align
          with general stall-fed goat management principles:
        </p>

        <ul class="m-0 list-none space-y-2.5 p-0 text-sm text-[#58684C]">
          {
            generalCarePrinciples.map((point) => (
              <li class="flex items-start gap-2.5 rounded-2xl bg-white p-3.5 ring-1 ring-[#43563A]/8">
                <CheckCircle2 class="mt-0.5 size-4 shrink-0 text-[#438C38]" aria-hidden="true" />
                <span>{point}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <Section surface="main">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
      <div class="lg:col-span-7 space-y-4">
        <span class="text-xs font-heading font-bold uppercase tracking-wider text-[#438C38]">
          Farm Offerings
        </span>
        <h2 class="m-0 font-heading text-3xl font-extrabold text-[#43563A]">
          Three Confirmed Offerings From MSV Goat Farm
        </h2>
        <div class="space-y-3">
          {
            products.map((product) => (
              <div class="rounded-2xl bg-white p-4 ring-1 ring-[#43563A]/10 shadow-sm flex flex-col gap-1">
                <a
                  href={product.href}
                  class="font-heading text-base font-bold text-[#43563A] no-underline hover:text-[#438C38]"
                >
                  {product.name}{' '}
                  {product.tamilName && (
                    <span lang="ta" class="text-sm font-semibold text-[#438C38]">
                      ({product.tamilName})
                    </span>
                  )}{' '}
                  &rarr;
                </a>
                <p class="m-0 text-sm text-[#58684C]">{product.shortDescription}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="lg:col-span-5 rounded-[1.5rem] bg-[#F4FBE9] p-6 sm:p-8 ring-1 ring-[#63A83E]/25 flex flex-col justify-between gap-5">
        <div class="space-y-3">
          <span class="inline-flex items-center gap-1.5 text-xs font-heading font-bold uppercase tracking-wider text-[#438C38]">
            <MessageCircle class="size-4" aria-hidden="true" />
            <span>Direct Communication</span>
          </span>
          <h2 class="m-0 font-heading text-2xl font-extrabold text-[#43563A]">
            Speak With the Farm Directly
          </h2>
          <p class="m-0 text-sm sm:text-base leading-relaxed text-[#58684C]">
            Specific details not published online — including exact village directions in Theni,
            visiting hours, breed varieties, feeding schedules, milk volume, and Uppukandam pack
            options — can be confirmed directly with the farm owner at{' '}
            <strong class="text-[#43563A]">{settings.contact.phoneDisplay}</strong>.
          </p>
        </div>

        <div class="flex flex-wrap gap-3">
          <Button href="/gallery/" variant="secondary">
            <span>View Farm Gallery</span>
            <ArrowRight class="size-4 shrink-0" aria-hidden="true" />
          </Button>
          <Button href="/contact/" variant="primary">
            <span>Contact Details</span>
          </Button>
        </div>
      </div>
    </div>
  </Section>

  <ContactCtaSection
    whatsappNumber={settings.contact.whatsappNumber}
    phoneDisplay={settings.contact.phoneDisplay}
    phoneConfirmed={settings.contact.phoneConfirmed}
  />
</BaseLayout>
