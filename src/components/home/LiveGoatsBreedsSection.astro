---
import { MessageCircle } from 'lucide-astro';
import Section from '../common/Section.astro';
import WhatsAppButton from '../common/WhatsAppButton.astro';

export interface Props {
  whatsappNumber: string;
}

const { whatsappNumber } = Astro.props;

const herdHighlights = [
  {
    title: 'Current Herd Availability',
    detail:
      'Live goat availability varies by season and farm stock. Message us on WhatsApp to check currently available goats.',
  },
  {
    title: 'Breed Information on Enquiry',
    detail:
      'Confirmed breed details and individual goat specifications are shared directly by the farm owner during your enquiry.',
  },
  {
    title: 'Direct Selection & Discussion',
    detail:
      'Speak directly with MSV Goat Farm in Theni by WhatsApp or telephone to discuss your requirement.',
  },
];
---

<Section id="live-goats-showcase" surface="main" class="reveal-on-scroll">
  <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-12">
    <div class="min-w-0 space-y-6 lg:col-span-6">
      <div class="space-y-3">
        <span class="inline-flex items-center rounded-full bg-[#F4FBE9] px-3.5 py-1 text-xs font-heading font-bold uppercase tracking-wider text-[#438C38] ring-1 ring-[#63A83E]/25">
          Live Goats &amp; Herd Overview
        </span>
        <h2 class="m-0 font-heading text-3xl sm:text-4xl font-extrabold text-[#43563A]">
          Live Goats for Sale in Theni
        </h2>
        <p class="m-0 text-base leading-relaxed text-[#58684C]">
          MSV Goat Farm raises live goats in elevated open-sided sheds in Theni, Tamil Nadu.
          Because herd stock changes regularly, we share current availability and confirmed breed
          details directly upon enquiry.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-3 lg:grid-cols-1">
        {
          herdHighlights.map((item) => (
            <div class="rounded-2xl bg-[#FFFDF4] p-4 ring-1 ring-[#43563A]/10">
              <h3 class="m-0 font-heading text-base font-bold text-[#43563A]">{item.title}</h3>
              <p class="m-0 mt-1 text-sm leading-relaxed text-[#58684C]">{item.detail}</p>
            </div>
          ))
        }
      </div>

      <div class="flex flex-wrap items-center gap-3 pt-1">
        <WhatsAppButton
          phoneNumber={whatsappNumber}
          message="Hello MSV Goat Farm, I would like to enquire about currently available live goats and breeds in Theni."
          label="Check Live Goat Availability"
          variant="primary"
        />
        <span class="inline-flex items-center gap-1.5 rounded-full bg-[#FFF1D5] px-3.5 py-2 text-xs font-semibold text-[#43563A]">
          <MessageCircle class="size-3.5 text-[#438C38]" aria-hidden="true" />
          <span>Breed details confirmed directly by farm owner</span>
        </span>
      </div>
    </div>

    <div class="min-w-0 lg:col-span-6">
      <figure class="m-0 overflow-hidden rounded-[1.5rem] bg-white p-2 shadow-[0_14px_38px_-12px_rgba(67,86,58,0.16)] ring-1 ring-[#43563A]/10">
        <img
          src="/images/live-goats/live-goats-elevated-shed.webp"
          srcset="/images/live-goats/live-goats-elevated-shed-800.webp 800w, /images/live-goats/live-goats-elevated-shed.webp 1200w"
          sizes="(max-width: 1024px) 100vw, 50vw"
          alt="Goats inside an elevated wooden-slatted pen with yellow tubular metal railings and feed trough at MSV Goat Farm"
          width="1200"
          height="900"
          loading="lazy"
          decoding="async"
          class="aspect-[4/3] w-full rounded-[1.125rem] object-cover"
        />
        <figcaption class="px-3 pt-2.5 pb-1 text-xs text-[#58684C]">
          Illustrative herd visualization modeled on the farm&rsquo;s elevated slatted pens in Theni.
        </figcaption>
      </figure>
    </div>
  </div>
</Section>

