---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../common/PageHero.astro';
import Section from '../common/Section.astro';
import VarietyShowcase from '../products/VarietyShowcase.astro';

export interface Props {
  breeds: CollectionEntry<'breeds'>[];
  whatsappNumber: string;
}

const { breeds, whatsappNumber } = Astro.props;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Live Goats', href: '/live-goats-for-sale-theni/' },
  { label: 'Goat Breeds', href: '/goat-breeds/' },
];
---

<BaseLayout
  title="Goat Breeds | MSV Goat Farm, Theni"
  description="Owner-confirmed goat breeds and varieties raised at MSV Goat Farm in Theni, Tamil Nadu."
  breadcrumbs={breadcrumbs}
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Confirmed Herd Breeds"
    title="Goat Varieties at MSV Goat Farm"
    description="Owner-confirmed goat varieties and characteristics at MSV Goat Farm in Theni, Tamil Nadu."
  />

  <Section surface="main">
    <VarietyShowcase breeds={breeds} whatsappNumber={whatsappNumber} />
  </Section>
</BaseLayout>
