---
import { Phone } from 'lucide-astro';
import { buildPhoneHref } from '../../utils/whatsapp';
import Button from '../common/Button.astro';
import Section from '../common/Section.astro';
import WhatsAppButton from '../common/WhatsAppButton.astro';

export interface Props {
  whatsappNumber: string;
  phoneDisplay: string;
  phoneConfirmed: boolean;
}

const { whatsappNumber, phoneDisplay, phoneConfirmed } = Astro.props;
const phoneHref = phoneConfirmed ? buildPhoneHref(phoneDisplay) : null;
---

<Section id="contact-cta" surface="main" class="reveal-on-scroll">
  <div class="relative overflow-hidden rounded-[1.75rem] bg-primary-gradient p-8 sm:p-10 lg:p-14 text-white shadow-[0_22px_50px_-15px_rgba(67,140,56,0.42)]">
    <div class="relative z-10 grid grid-cols-1 items-center gap-8 lg:grid-cols-12">
      <div class="min-w-0 space-y-4 lg:col-span-7">
        <span class="inline-flex items-center rounded-full bg-white/20 px-3.5 py-1 text-xs font-heading font-bold uppercase tracking-wider text-[#FFFDF4]">
          Direct Farm Contact &bull; Theni, Tamil Nadu
        </span>
        <h2 class="m-0 font-heading text-3xl sm:text-4xl font-extrabold text-white">
          Speak Directly With MSV Goat Farm
        </h2>
        <p class="m-0 max-w-2xl text-base sm:text-lg leading-relaxed text-[#FFFDF4]/95">
          Confirm available goat varieties, traditional Uppukandam (<span lang="ta">உப்புக்கண்டம்</span>)
          batches, or goat milk supply in Theni directly with the farm on WhatsApp or telephone.
        </p>
      </div>

      <div class="min-w-0 flex flex-col gap-3 lg:col-span-5 lg:items-end">
        <div class="flex flex-wrap gap-3 lg:justify-end">
          <WhatsAppButton
            phoneNumber={whatsappNumber}
            message="Hello MSV Goat Farm, I would like to ask about live goats, Uppukandam, or goat milk availability in Theni."
            label="Message on WhatsApp"
            variant="gold"
            size="lg"
          />

          {
            phoneHref ? (
              <Button href={phoneHref} variant="outline-light" size="lg">
                <Phone class="size-4 shrink-0" aria-hidden="true" />
                <span>Call {phoneDisplay}</span>
              </Button>
            ) : (
              <Button href="/contact/" variant="outline-light" size="lg">
                <span>Contact Page</span>
              </Button>
            )
          }
        </div>
      </div>
    </div>
  </div>
</Section>
