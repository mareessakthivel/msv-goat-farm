---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../common/PageHero.astro';
import Section from '../common/Section.astro';
import WhatsAppButton from '../common/WhatsAppButton.astro';

export interface Props {
  goats: CollectionEntry<'goats'>[];
  whatsappNumber: string;
}

const { goats, whatsappNumber } = Astro.props;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Available Goats', href: '/available-goats/' },
];
---

<BaseLayout
  title="Available Goats | MSV Goat Farm, Theni"
  description="Confirmed individual live goats currently available for enquiry at MSV Goat Farm in Theni, Tamil Nadu."
  breadcrumbs={breadcrumbs}
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Live Stock Enquiries"
    title="Available Goats at MSV Goat Farm"
    description="Owner-confirmed goats available for direct WhatsApp and telephone enquiries in Theni."
  />

  <Section surface="main">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        goats.map((goat) => (
          <article class="brand-card rounded-[1.25rem] bg-white p-6 ring-1 ring-[#43563A]/10 shadow-sm space-y-4">
            <h2 class="m-0 font-heading text-xl font-bold text-[#43563A]">{goat.data.name}</h2>
            <p class="m-0 text-sm leading-relaxed text-[#58684C]">{goat.data.notes}</p>
            <WhatsAppButton
              phoneNumber={whatsappNumber}
              message={`Hello MSV Goat Farm, I would like to enquire about ${goat.data.name} in Theni.`}
              label="Enquire on WhatsApp"
              variant="primary"
              size="sm"
            />
          </article>
        ))
      }
    </div>
  </Section>
</BaseLayout>

