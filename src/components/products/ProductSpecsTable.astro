---
export interface SpecRow {
  label: string;
  value: string;
  note?: string;
}

export interface Props {
  title: string;
  subtitle?: string;
  rows: SpecRow[];
}

const { title, subtitle, rows } = Astro.props;
---

<div class="rounded-[1.5rem] bg-white p-6 sm:p-8 ring-1 ring-[#43563A]/10 shadow-[0_10px_28px_-12px_rgba(67,86,58,0.12)] space-y-5">
  <div class="space-y-1.5 border-b border-[#43563A]/10 pb-4">
    <h2 class="m-0 font-heading text-2xl sm:text-3xl font-extrabold text-[#43563A]">
      {title}
    </h2>
    {subtitle && <p class="m-0 text-sm text-[#58684C]">{subtitle}</p>}
  </div>

  <dl class="m-0 grid grid-cols-1 divide-y divide-[#43563A]/10">
    {
      rows.map((row) => (
        <div class="grid grid-cols-1 gap-1.5 py-3.5 sm:grid-cols-12 sm:gap-4 sm:items-baseline">
          <dt class="font-heading text-sm font-bold text-[#43563A] sm:col-span-4">
            {row.label}
          </dt>
          <dd class="m-0 text-sm text-[#58684C] sm:col-span-8">
            <span class="font-medium text-[#43563A]">{row.value}</span>
            {row.note && (
              <span class="mt-0.5 block text-xs text-[#58684C]">{row.note}</span>
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</div>

