---
import { ArrowRight } from 'lucide-astro';
import type { ProductItem } from '../home/ProductsSection.astro';
import Section from '../common/Section.astro';
import Button from '../common/Button.astro';
import ProductCard from './ProductCard.astro';

export interface Props {
  currentId: string;
  products: ProductItem[];
  whatsappNumber: string;
}

const { currentId, products, whatsappNumber } = Astro.props;
const related = products.filter((p) => p.id !== currentId);
---

<Section id="related-products" surface="soft-green">
  <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div class="space-y-1.5">
      <span class="inline-flex items-center rounded-full bg-white px-3.5 py-1 text-xs font-heading font-bold uppercase tracking-wider text-[#438C38] ring-1 ring-[#63A83E]/25">
        Explore More From MSV Goat Farm
      </span>
      <h2 class="m-0 font-heading text-2xl sm:text-3xl font-extrabold text-[#43563A]">
        Other Farm Products in Theni
      </h2>
    </div>

    <Button href="/products/" variant="secondary" class="self-start sm:self-auto shrink-0">
      <span>View All Products</span>
      <ArrowRight class="size-4 shrink-0" aria-hidden="true" />
    </Button>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
    {
      related.map((product) => (
        <ProductCard
          name={product.name}
          tamilName={product.tamilName}
          categoryLabel={product.categoryLabel}
          locationLabel={product.locationLabel}
          description={product.shortDescription}
          highlights={product.highlights}
          href={product.href}
          exploreLabel={product.exploreLabel}
          enquiryLabel={product.enquiryLabel}
          whatsappNumber={whatsappNumber}
          whatsappMessage={product.whatsappMessage}
          imageSrc={product.image.src}
          imageAlt={product.image.alt}
          placeholderLabel={product.image.placeholderLabel}
        />
      ))
    }
  </div>
</Section>

