---
import { getCollection, getEntry } from 'astro:content';
import { BookOpen, Flame, Info } from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductPdpHero from '../components/products/ProductPdpHero.astro';
import ProductSpecsTable from '../components/products/ProductSpecsTable.astro';
import RelatedProductsSection from '../components/products/RelatedProductsSection.astro';
import Section from '../components/common/Section.astro';
import InfoChecklist from '../components/products/InfoChecklist.astro';
import FaqAccordion from '../components/products/FaqAccordion.astro';
import ContactCtaSection from '../components/home/ContactCtaSection.astro';

const siteSettings = await getEntry('settings', 'site');
const settings = siteSettings!.data;
const allProducts = (await getCollection('products'))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);
const product = allProducts.find((p) => p.id === 'uppukandam')!;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Our Products', href: '/products/' },
  { label: 'Uppukandam', href: '/uppukandam-theni/' },
];

const gallery = [
  {
    src: '/images/uppukandam/msv-traditional-uppukandam.webp',
    src800: '/images/uppukandam/msv-traditional-uppukandam-800.webp',
    alt: product.image.alt,
    caption: 'Illustrative product photograph representing traditional dried goat meat (Uppukandam).',
    label: 'Uppukandam Presentation',
  },
  {
    src: '/images/live-goats/live-goats-elevated-shed.webp',
    src800: '/images/live-goats/live-goats-elevated-shed-800.webp',
    alt: 'Goats inside elevated pens at MSV Goat Farm in Theni',
    caption: 'Illustrative livestock view modeled on MSV Goat Farm in Theni, Tamil Nadu.',
    label: 'Farm Livestock Context',
  },
  {
    src: '/images/hero/msv-goat-farm-theni-hero.webp',
    src800: '/images/hero/msv-goat-farm-theni-hero-800.webp',
    alt: 'MSV Goat Farm elevated shed compound and green surroundings in Theni',
    caption: 'Illustrative overview of MSV Goat Farm in Theni, Tamil Nadu.',
    label: 'MSV Goat Farm, Theni',
  },
];

const keyFacts = [
  { label: 'Product Type', value: 'Cured & Dried Goat Meat' },
  { label: 'Tamil Name', value: 'உப்புக்கண்டம் (Uppukandam)' },
  { label: 'Batch Format', value: 'Small Farm Batches' },
  { label: 'Pack Size & Price', value: 'Confirmed on Enquiry' },
];

const specRows = [
  {
    label: 'Product Name',
    value: 'Traditional Uppukandam (உப்புக்கண்டம்)',
  },
  {
    label: 'Form & State',
    value: 'Dehydrated / Dried Goat Meat Cuts (Not Fresh Raw Meat)',
    note: 'Cured with salt and spices and dried to draw out moisture.',
  },
  {
    label: 'Visual Appearance',
    value: 'Firm, Shrunken, Dark Reddish-Brown to Spiced-Brown Pieces',
  },
  {
    label: 'Traditional Culinary Use',
    value: 'Shallow-Fried (Porichathu) & Slow-Simmered Gravies (Kuzhambu)',
    note: 'Typically pounded lightly and flash-fried crisp in oil or ghee before serving.',
  },
  {
    label: 'Ingredients & Cut Type',
    value: 'Confirmed Per Farm Batch',
    note: 'Ask the owner whether current batches use boneless strips or bone-in pieces and exact spices.',
  },
  {
    label: 'Pack Sizes & Pricing',
    value: 'Confirmed Directly With Farm',
    note: 'Unit pack weights and batch rates are shared during enquiry.',
  },
  {
    label: 'Storage Guidance',
    value: 'Confirmed Directly With Farm',
    note: 'Request recommended airtight container storage and consumption timeframe.',
  },
];

const jumpLinks = [
  { label: 'Specifications', href: '#specifications' },
  { label: 'What Is Uppukandam', href: '#what-is-uppukandam' },
  { label: 'Traditional Preparation', href: '#preparation-context' },
  { label: 'Details to Confirm', href: '#buyer-checklist' },
  { label: 'FAQs', href: '#faqs' },
];

const confirmationItems = [
  {
    title: 'Ingredients & Spice Mix',
    description:
      'Ask the farm which spices and curing ingredients (such as rock salt, turmeric, black pepper, or chilli) are used in the current batch.',
  },
  {
    title: 'Cut & Preparation Method',
    description:
      'Confirm whether the current Uppukandam batch uses boneless strips or bone-in cuts and how the batch was dried.',
  },
  {
    title: 'Quantity & Pack Size',
    description:
      'Check available unit pack weights or bulk quantities prepared in the current batch before confirming your order.',
  },
  {
    title: 'Current Price',
    description:
      'Pricing per pack or weight is shared directly by MSV Goat Farm based on the current dried batch.',
  },
  {
    title: 'Storage Instructions',
    description:
      'Confirm airtight container storage guidance and the farm’s recommended consumption window for that batch.',
  },
  {
    title: 'Batch Readiness & Pickup',
    description:
      'Because Uppukandam is dried in batches rather than sold as fresh raw meat, confirm when the next batch is ready in Theni.',
  },
];

const faqs = [
  {
    question: 'What is the difference between Uppukandam and fresh goat meat?',
    answer:
      'Uppukandam (உப்புக்கண்டம்) is not fresh raw goat meat. It is goat meat that has been trimmed, seasoned, cured with salt and spices, and dried so moisture is removed, creating a firm preserved product with concentrated savoury taste.',
  },
  {
    question: 'How is Uppukandam traditionally cooked at home?',
    answer:
      'In Tamil households, dried Uppukandam pieces are commonly tapped or pounded lightly to soften the fibres and quickly shallow-fried in hot oil or ghee (porichathu) to pair with rasam rice, sambar rice, or dal, or rehydrated inside traditional tamarind gravies.',
  },
  {
    question: 'Does this page describe MSV Goat Farm’s exact recipe or pack weights?',
    answer:
      'No. The culinary steps shown on this page describe general Tamil Nadu traditional preparation background. Exact ingredients, curing details, pack weights, shelf life, and batch pricing are confirmed directly with MSV Goat Farm.',
  },
  {
    question: 'How can I check current Uppukandam batch availability in Theni?',
    answer:
      'Message +91 95246 95724 on WhatsApp or call the farm directly to ask whether a batch is currently available, along with pack options and pickup details.',
  },
];
---

<BaseLayout
  title="Uppukandam (உப்புக்கண்டம்) in Theni | Traditional Dried Goat Meat | MSV Goat Farm"
  description="Traditional Uppukandam (உப்புக்கண்டம்) — dried goat meat in Theni from MSV Goat Farm. Review product specs, Tamil culinary background, characteristics, and batch checklist."
  ogImage="/images/uppukandam/msv-traditional-uppukandam.webp"
  heroPreloadImage="/images/uppukandam/msv-traditional-uppukandam.webp"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <ProductPdpHero
    breadcrumbs={breadcrumbs}
    eyebrow="Traditional Dried Meat • Theni, Tamil Nadu"
    title="Traditional Uppukandam in Theni"
    tamilSubtitle="உப்புக்கண்டம்"
    description={product.summaryIntro ?? product.shortDescription}
    highlights={product.highlights}
    keyFacts={keyFacts}
    optionNoteTitle="Batch Options to Confirm With Farm"
    optionNoteText="Available pack weight, spice profile, bone-in vs. boneless cut, storage guidance, and batch price are confirmed directly on WhatsApp or phone."
    gallery={gallery}
    whatsappNumber={settings.contact.whatsappNumber}
    whatsappMessage={product.whatsappMessage}
    whatsappLabel="Enquire for Batch & Price"
    phoneDisplay={settings.contact.phoneDisplay}
    phoneConfirmed={settings.contact.phoneConfirmed}
    jumpLinks={jumpLinks}
  />

  <Section id="specifications" surface="main">
    <div class="mx-auto max-w-5xl">
      <ProductSpecsTable
        title="Product Specifications &amp; Food Profile"
        subtitle="Key characteristics and buyer enquiry scope for traditional Uppukandam (உப்புக்கண்டம்)."
        rows={specRows}
      />
    </div>
  </Section>

  <Section id="what-is-uppukandam" surface="soft-green">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
      <article class="rounded-[1.5rem] bg-white p-6 sm:p-8 ring-1 ring-[#43563A]/10 shadow-sm space-y-4">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-[#FFF1D5] px-3 py-1 text-xs font-heading font-bold uppercase tracking-wider text-[#43563A]">
          <Flame class="size-3.5 text-[#EFA45C]" aria-hidden="true" />
          <span>What Is Uppukandam?</span>
        </span>
        <h2 class="m-0 font-heading text-2xl sm:text-3xl font-extrabold text-[#43563A]">
          A Traditional Cured &amp; Dried Goat Meat Speciality
        </h2>
        <p class="m-0 text-sm sm:text-base leading-relaxed text-[#58684C]">
          <strong class="text-[#43563A]">Uppukandam (<span lang="ta">உப்புக்கண்டம்</span>)</strong>
          is an iconic dried goat meat product from Tamil Nadu, made by salting, spicing, and
          drying cut pieces of goat meat until moisture is drawn out.
        </p>
        <p class="m-0 text-sm sm:text-base leading-relaxed text-[#58684C]">
          Unlike fresh raw meat kept cold for immediate curries, Uppukandam is a cured, firm,
          low-moisture food item created for shelf stability and intense, peppery savoury flavour
          once fried or simmered.
        </p>
      </article>

      <article class="rounded-[1.5rem] bg-white p-6 sm:p-8 ring-1 ring-[#43563A]/10 shadow-sm space-y-4">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-[#F4FBE9] px-3 py-1 text-xs font-heading font-bold uppercase tracking-wider text-[#438C38]">
          <BookOpen class="size-3.5" aria-hidden="true" />
          <span>Food Context &amp; Appearance</span>
        </span>
        <h2 class="m-0 font-heading text-2xl sm:text-3xl font-extrabold text-[#43563A]">
          Tamil Culinary Heritage &amp; Characteristics
        </h2>
        <p class="m-0 text-sm sm:text-base leading-relaxed text-[#58684C]">
          Historically developed across southern and rural Tamil households before home refrigeration,
          curing goat meat allowed families to preserve meat naturally during warm dry seasons.
        </p>
        <ul class="m-0 list-disc pl-5 space-y-1.5 text-sm sm:text-base text-[#58684C]">
          <li>
            <strong class="text-[#43563A]">Appearance:</strong> Shrunken, firm, dark reddish-brown
            to spiced-brown dried chunks or strips with spices coating the surface.
          </li>
          <li>
            <strong class="text-[#43563A]">Texture &amp; Cooking:</strong> Too dense to eat unheated;
            traditionally tapped lightly and pan-fried crisp (<span class="italic">Uppukandam porichathu</span>)
            for rasam or sambar rice, or added to traditional tamarind gravies.
          </li>
        </ul>
      </article>
    </div>
  </Section>

  <Section id="preparation-context" surface="soft-cream">
    <div class="mx-auto max-w-5xl rounded-[1.5rem] bg-white p-6 sm:p-8 ring-1 ring-[#EFA45C]/35 shadow-sm space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-[#FFF1D5] px-3 py-1 text-xs font-heading font-bold uppercase tracking-wider text-[#43563A]">
          <Info class="size-3.5 text-[#EFA45C]" aria-hidden="true" />
          <span>General Traditional Preparation Context</span>
        </span>
        <span class="text-xs font-semibold text-[#58684C]">
          General culinary background &mdash; not farm-specific recipe claims
        </span>
      </div>

      <h2 class="m-0 font-heading text-2xl sm:text-3xl font-extrabold text-[#43563A]">
        How Traditional Uppukandam Is Generally Prepared in Tamil Nadu
      </h2>
      <p class="m-0 text-sm sm:text-base leading-relaxed text-[#58684C]">
        While MSV Goat Farm&rsquo;s specific recipe and preparation process are shared directly upon
        enquiry rather than published online, traditional culinary sources in Tamil Nadu typically
        describe three general stages:
      </p>

      <div class="grid grid-cols-1 gap-4 md:grid-cols-3 pt-2">
        <div class="rounded-2xl bg-[#FFFDF4] p-4 ring-1 ring-[#43563A]/10 space-y-1.5">
          <h3 class="m-0 font-heading text-base font-bold text-[#43563A]">1. Lean Trimming</h3>
          <p class="m-0 text-xs sm:text-sm leading-relaxed text-[#58684C]">
            Goat meat is cut into uniform strips or small slabs with excess visible fat trimmed away
            so pieces dry evenly.
          </p>
        </div>
        <div class="rounded-2xl bg-[#FFFDF4] p-4 ring-1 ring-[#43563A]/10 space-y-1.5">
          <h3 class="m-0 font-heading text-base font-bold text-[#43563A]">2. Salt &amp; Spice Curing</h3>
          <p class="m-0 text-xs sm:text-sm leading-relaxed text-[#58684C]">
            Pieces are traditionally rubbed with salt, turmeric powder, and regional spice pastes
            (such as black pepper, cumin, or chilli).
          </p>
        </div>
        <div class="rounded-2xl bg-[#FFFDF4] p-4 ring-1 ring-[#43563A]/10 space-y-1.5">
          <h3 class="m-0 font-heading text-base font-bold text-[#43563A]">3. Multi-Day Drying</h3>
          <p class="m-0 text-xs sm:text-sm leading-relaxed text-[#58684C]">
            Cut pieces are laid or hung under warm open-air sunlight (often covered with breathable
            cloth) until firm and low in moisture.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <Section id="buyer-checklist" surface="main">
    <div class="mx-auto mb-8 max-w-3xl text-center space-y-2.5">
      <span class="inline-flex items-center rounded-full bg-[#F4FBE9] px-3.5 py-1 text-xs font-heading font-bold uppercase tracking-wider text-[#438C38] ring-1 ring-[#63A83E]/25">
        Buyer Confirmation Checklist
      </span>
      <h2 class="m-0 font-heading text-3xl font-extrabold text-[#43563A]">
        Product Information to Confirm With MSV Goat Farm
      </h2>
      <p class="m-0 text-sm sm:text-base text-[#58684C]">
        Because recipe specifics, pack sizes, shelf life, and batch timing are not published on
        this website, confirm these six points directly before buying:
      </p>
    </div>

    <InfoChecklist items={confirmationItems} columns={3} />
  </Section>

  <RelatedProductsSection
    currentId="uppukandam"
    products={allProducts}
    whatsappNumber={settings.contact.whatsappNumber}
  />

  <Section id="faqs" surface="main">
    <div class="mx-auto max-w-3xl">
      <h2 class="m-0 mb-6 text-center font-heading text-3xl font-extrabold text-[#43563A]">
        Uppukandam (<span lang="ta">உப்புக்கண்டம்</span>) FAQs
      </h2>
      <FaqAccordion items={faqs} />
    </div>
  </Section>

  <ContactCtaSection
    whatsappNumber={settings.contact.whatsappNumber}
    phoneDisplay={settings.contact.phoneDisplay}
    phoneConfirmed={settings.contact.phoneConfirmed}
  />
</BaseLayout>
