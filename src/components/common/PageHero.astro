---
import Breadcrumbs, { type BreadcrumbItem } from './Breadcrumbs.astro';

export interface Props {
  breadcrumbs: BreadcrumbItem[];
  eyebrow: string;
  title: string;
  tamilSubtitle?: string;
  description: string;
}

const { breadcrumbs, eyebrow, title, tamilSubtitle, description } = Astro.props;
---

<section class="bg-hero-gradient border-b border-[#43563A]/8 px-4 pt-8 pb-12 sm:px-6 sm:pt-10 sm:pb-14 lg:px-8">
  <div class="mx-auto max-w-[78rem]">
    <Breadcrumbs items={breadcrumbs} />

    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12">
      <div class="min-w-0 space-y-4 lg:col-span-7">
        <span class="inline-flex items-center rounded-full bg-white/90 px-3.5 py-1 text-xs font-heading font-bold uppercase tracking-wider text-[#438C38] ring-1 ring-[#63A83E]/25">
          {eyebrow}
        </span>

        <h1 class="m-0 font-heading text-[clamp(2rem,1.45rem+2.2vw,3rem)] font-extrabold leading-[1.14] text-[#43563A]">
          {title}
          {
            tamilSubtitle && (
              <span lang="ta" class="mt-1 block text-[0.72em] font-bold text-[#438C38]">
                {tamilSubtitle}
              </span>
            )
          }
        </h1>

        <p class="m-0 max-w-2xl text-base sm:text-lg leading-relaxed text-[#58684C]">
          {description}
        </p>

        <slot name="actions" />
      </div>

      <div class="min-w-0 lg:col-span-5">
        <slot name="media" />
      </div>
    </div>
  </div>
</section>

