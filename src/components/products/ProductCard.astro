---
import { ArrowRight, Camera } from 'lucide-astro';
import WhatsAppButton from '../common/WhatsAppButton.astro';

export interface Props {
  name: string;
  tamilName?: string;
  description: string;
  href: string;
  enquiryLabel: string;
  whatsappNumber: string;
  whatsappMessage: string;
  imageSrc?: string;
  imageAlt: string;
  placeholderLabel?: string;
  wideOnTablet?: boolean;
}

const {
  name,
  tamilName,
  description,
  href,
  enquiryLabel,
  whatsappNumber,
  whatsappMessage,
  imageSrc,
  imageAlt,
  placeholderLabel,
  wideOnTablet = false,
} = Astro.props;

const imageSrc800 = imageSrc ? imageSrc.replace(/\.webp$/, '-800.webp') : undefined;
---

<article
  class:list={[
    'brand-card min-w-0 group flex flex-col overflow-hidden rounded-[1.25rem] bg-white border border-[#43563A]/10 shadow-[0_10px_30px_-10px_rgba(67,86,58,0.11)] transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-[0_18px_40px_-12px_rgba(67,140,56,0.18)]',
    wideOnTablet && 'md:col-span-2 md:flex-row lg:col-span-1 lg:flex-col',
  ]}
>
  <div
    class:list={[
      'relative aspect-[4/3] w-full overflow-hidden bg-[#F4FBE9]',
      wideOnTablet && 'md:w-1/2 md:shrink-0 lg:w-full',
    ]}
  >
    {
      imageSrc ? (
        <img
          src={imageSrc}
          srcset={imageSrc800 ? `${imageSrc800} 800w, ${imageSrc} 1200w` : undefined}
          sizes={
            wideOnTablet
              ? '(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 33vw'
              : '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw'
          }
          alt={imageAlt}
          width="1200"
          height="900"
          loading="lazy"
          decoding="async"
          class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        />
      ) : (
        <div class="flex size-full flex-col items-center justify-center gap-3 bg-gradient-to-br from-[#F4FBE9] via-[#FFFDF4] to-[#FFF1D5] p-6 text-center">
          <span class="inline-flex size-12 items-center justify-center rounded-full bg-white text-[#438C38] shadow-sm ring-1 ring-[#63A83E]/20">
            <Camera class="size-5" aria-hidden="true" />
          </span>
          <div class="space-y-1">
            <p class="m-0 font-heading text-base font-bold text-[#43563A]">
              {name}
              {tamilName && (
                <span lang="ta" class="block text-sm font-semibold text-[#438C38]">
                  {tamilName}
                </span>
              )}
            </p>
            <p class="m-0 text-xs font-medium text-[#58684C]">
              {placeholderLabel ?? 'Product visual'}
            </p>
          </div>
        </div>
      )
    }
  </div>

  <div class="flex flex-1 flex-col justify-between p-6">
    <div>
      <div class="mb-2 flex flex-wrap items-baseline gap-2">
        <h3 class="m-0 font-heading text-xl font-bold text-[#43563A]">{name}</h3>
        {
          tamilName && (
            <span
              lang="ta"
              class="rounded-full bg-[#FFF1D5] px-2.5 py-0.5 text-xs font-semibold text-[#43563A]"
            >
              {tamilName}
            </span>
          )
        }
      </div>

      <p class="m-0 mb-5 text-[0.9375rem] leading-relaxed text-[#58684C]">
        {description}
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-3 pt-2 border-t border-[#43563A]/8">
      <WhatsAppButton
        phoneNumber={whatsappNumber}
        message={whatsappMessage}
        label={enquiryLabel}
        variant="primary"
        size="sm"
        class="flex-1 sm:flex-initial"
      />
      <a
        href={href}
        class="inline-flex min-h-[44px] items-center gap-1.5 px-2 text-sm font-heading font-bold text-[#438C38] no-underline hover:text-[#35732C]"
      >
        <span>Details</span>
        <ArrowRight class="size-4 shrink-0" aria-hidden="true" />
      </a>
    </div>
  </div>
</article>
