---
export interface BreadcrumbItem {
  label: string;
  href: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumbs" class="breadcrumb mb-5">
  <ol class="m-0 flex flex-wrap items-center gap-x-2 gap-y-1.5 list-none p-0 text-sm">
    {
      items.map((item, idx) => {
        const isCurrent = idx === items.length - 1;
        return (
          <li class="inline-flex items-center gap-2">
            <a
              href={item.href}
              aria-current={isCurrent ? 'page' : undefined}
              class:list={[
                'rounded px-1 py-0.5 transition-colors',
                isCurrent
                  ? 'font-semibold text-[#43563A] no-underline'
                  : 'text-[#58684C] underline decoration-[#63A83E]/45 underline-offset-4 hover:text-[#438C38]',
              ]}
            >
              {item.label}
            </a>
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .breadcrumb > ol > li + li::before {
    content: '/' / '';
    color: rgba(88, 104, 76, 0.55);
    font-weight: 500;
  }

  .breadcrumb a:focus-visible {
    position: relative;
    z-index: 1;
    outline: 3px solid #438C38;
    outline-offset: 2px;
  }

  @media (forced-colors: active) {
    .breadcrumb a[aria-current='page'] {
      text-decoration: underline;
    }
  }
</style>

