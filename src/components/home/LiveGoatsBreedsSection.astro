---
import type { CollectionEntry } from 'astro:content';
import Section from '../common/Section.astro';
import VarietyShowcase from '../products/VarietyShowcase.astro';

export interface Props {
  breeds: CollectionEntry<'breeds'>[];
  whatsappNumber: string;
}

const { breeds, whatsappNumber } = Astro.props;
---

<Section id="goat-varieties" surface="soft-green" class="reveal-on-scroll">
  <div class="mx-auto mb-8 max-w-2xl text-center space-y-2.5">
    <span class="inline-flex items-center rounded-full bg-white px-3.5 py-1 text-xs font-heading font-bold uppercase tracking-wider text-[#438C38] ring-1 ring-[#63A83E]/25">
      Goat Varieties Showcase
    </span>
    <h2 class="m-0 font-heading text-3xl sm:text-4xl font-extrabold text-[#43563A]">
      Goat Breeds &amp; Herd Details
    </h2>
    <p class="m-0 text-base text-[#58684C]">
      MSV Goat Farm only publishes confirmed goat varieties verified directly by the farm owner.
    </p>
  </div>

  <VarietyShowcase
    breeds={breeds}
    whatsappNumber={whatsappNumber}
    showGuideLink={true}
  />
</Section>
