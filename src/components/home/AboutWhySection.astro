---
import { ArrowRight, MapPin, MessageSquare, Warehouse } from 'lucide-astro';
import Section from '../common/Section.astro';
import Button from '../common/Button.astro';
import WhatsAppButton from '../common/WhatsAppButton.astro';

export interface Props {
  whatsappNumber: string;
}

const { whatsappNumber } = Astro.props;

const pillars = [
  {
    icon: Warehouse,
    title: 'Elevated Shed Environment',
    text: 'Raised wooden and perforated slatted platforms with a timber entry ramp, open truss roof, and aisle troughs visible across our farm.',
  },
  {
    icon: MapPin,
    title: 'Focused Offerings in Theni',
    text: 'Specialising in three distinct areas: farm-reared live goats, traditional Uppukandam (உப்புக்கண்டம்), and farm-sourced goat milk.',
  },
  {
    icon: MessageSquare,
    title: 'Direct Owner Conversations',
    text: 'Buyers speak directly with MSV Goat Farm on WhatsApp or phone to confirm breed options, animal details, batch availability, and visits.',
  },
];
---

<Section id="about-farm" surface="main" class="reveal-on-scroll">
  <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-12">
    <div class="min-w-0 lg:col-span-6">
      <figure class="m-0 overflow-hidden rounded-[1.5rem] bg-white p-2 shadow-[0_14px_38px_-12px_rgba(67,86,58,0.16)] ring-1 ring-[#43563A]/10">
        <img
          src="/images/farm/msv-elevated-shed-exterior-ramp.webp"
          srcset="/images/farm/msv-elevated-shed-exterior-ramp-800.webp 800w, /images/farm/msv-elevated-shed-exterior-ramp.webp 1200w"
          sizes="(max-width: 1024px) 100vw, 50vw"
          alt="Exterior front view of the elevated goat shed with wooden slatted ramp, corrugated roof, yellow metal railings, coconut palms, and Theni hills"
          width="1200"
          height="900"
          loading="lazy"
          decoding="async"
          class="aspect-[4/3] w-full rounded-[1.125rem] object-cover"
        />
        <figcaption class="px-3 pt-2.5 pb-1 text-xs text-[#58684C]">
          Illustrative exterior visualization reflecting MSV Goat Farm&rsquo;s elevated shed and wooden ramp in Theni.
        </figcaption>
      </figure>
    </div>

    <div class="min-w-0 space-y-6 lg:col-span-6">
      <div class="space-y-3">
        <span class="inline-flex items-center rounded-full bg-white px-3.5 py-1 text-xs font-heading font-bold uppercase tracking-wider text-[#438C38] ring-1 ring-[#63A83E]/25">
          About &amp; Why Choose MSV Goat Farm
        </span>
        <h2 class="m-0 font-heading text-3xl sm:text-4xl font-extrabold text-[#43563A]">
          About MSV Goat Farm &amp; Why Buyers Connect Directly
        </h2>
        <p class="m-0 text-base leading-relaxed text-[#58684C]">
          Rather than publishing inflated claims or unverified stock counts, MSV Goat Farm presents
          its actual shed environment and confirmed product categories clearly so customers in Theni
          can enquire with confidence.
        </p>
      </div>

      <ul class="m-0 list-none space-y-4 p-0">
        {
          pillars.map((pillar) => {
            const Icon = pillar.icon;
            return (
              <li class="flex items-start gap-3.5 rounded-2xl bg-white/90 p-4 shadow-[0_6px_18px_-8px_rgba(67,86,58,0.10)] ring-1 ring-[#43563A]/8">
                <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-[#F4FBE9] text-[#438C38]">
                  <Icon class="size-5" aria-hidden="true" />
                </span>
                <div>
                  <h3 class="m-0 font-heading text-base font-bold text-[#43563A]">
                    {pillar.title}
                  </h3>
                  <p class="m-0 mt-1 text-sm leading-relaxed text-[#58684C]">
                    {pillar.text}
                  </p>
                </div>
              </li>
            );
          })
        }
      </ul>

      <div class="flex flex-wrap items-center gap-3 pt-1">
        <Button href="/about/" variant="secondary">
          <span>Read About MSV Goat Farm</span>
          <ArrowRight class="size-4 shrink-0" aria-hidden="true" />
        </Button>
        <WhatsAppButton
          phoneNumber={whatsappNumber}
          message="Hello MSV Goat Farm, I would like to learn more about your farm in Theni."
          label="Contact on WhatsApp"
          variant="primary"
        />
      </div>
    </div>
  </div>
</Section>
