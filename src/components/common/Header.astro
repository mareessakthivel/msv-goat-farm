---
import { Menu, MessageCircle, X } from 'lucide-astro';
import { buildWhatsAppUrl } from '../../utils/whatsapp';

export interface NavLink {
  label: string;
  href: string;
}

export interface Props {
  businessName: string;
  locationShort: string;
  navLinks: NavLink[];
  whatsappNumber: string;
  currentPath?: string;
}

const {
  businessName,
  locationShort,
  navLinks,
  whatsappNumber,
  currentPath = '/',
} = Astro.props;

const waHref = buildWhatsAppUrl({
  phoneNumber: whatsappNumber,
  message: 'Hello MSV Goat Farm, I would like to enquire about your farm products in Theni.',
});
---

<header class="site-header sticky top-0 z-40 border-b border-[#43563A]/10 bg-[#FFFDF4]/95 backdrop-blur-md">
  <div class="header-inner mx-auto flex max-w-[78rem] items-center justify-between gap-4 px-4 py-2.5 sm:px-6 lg:px-8">
    <a
      href="/"
      class="site-logo inline-flex items-center gap-3 no-underline shrink-0 group"
      aria-label={`${businessName} Home`}
    >
      <span class="inline-flex size-12 sm:size-14 items-center justify-center rounded-full bg-white p-1 shadow-[0_4px_12px_-4px_rgba(67,86,58,0.18)] ring-1 ring-[#63A83E]/25">
        <img
          src="/images/logo/msv-goat-farm-logo.webp"
          alt="MSV Goat Farm official emblem logo"
          width="56"
          height="56"
          class="size-full object-contain"
          loading="eager"
          decoding="async"
        />
      </span>
      <span class="flex flex-col leading-tight">
        <span class="font-heading text-base sm:text-lg font-extrabold tracking-tight text-[#43563A] group-hover:text-[#438C38] transition-colors">
          {businessName}
        </span>
        <span class="text-xs font-medium text-[#58684C]">
          {locationShort}
        </span>
      </span>
    </a>

    <nav class="site-nav flex items-center gap-3" aria-label="Primary">
      <button
        class="menu-button inline-flex min-h-[44px] items-center gap-2 rounded-full border border-[#438C38]/25 bg-white px-4 py-2 font-heading text-sm font-bold text-[#43563A] shadow-sm hover:bg-[#F4FBE9] cursor-pointer"
        type="button"
        popovertarget="site-menu"
        popovertargetaction="toggle"
        aria-controls="site-menu"
      >
        <Menu class="size-4 shrink-0" aria-hidden="true" />
        <span>Menu</span>
      </button>

      <ul id="site-menu" class="site-menu list-none m-0" popover="auto">
        <li class="menu-close-row flex items-center justify-between border-b border-[#43563A]/10 pb-2.5 mb-1">
          <span class="font-heading text-sm font-bold text-[#43563A]">Navigation</span>
          <button
            type="button"
            popovertarget="site-menu"
            popovertargetaction="hide"
            aria-label="Close navigation menu"
            class="inline-flex size-10 items-center justify-center rounded-full text-[#43563A] hover:bg-[#F4FBE9] cursor-pointer"
          >
            <X class="size-4" aria-hidden="true" />
          </button>
        </li>
        {
          navLinks.map((link) => {
            const isCurrent =
              link.href === '/' ? currentPath === '/' : currentPath === link.href;
            return (
              <li>
                <a
                  href={link.href}
                  aria-current={isCurrent ? 'page' : undefined}
                  class="nav-link inline-flex min-h-[44px] items-center rounded-full px-3.5 py-2 text-[0.9375rem] font-semibold text-[#43563A] no-underline transition-colors hover:bg-[#F4FBE9] hover:text-[#438C38]"
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
        <li class="nav-cta-item">
          <a
            href={waHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-[44px] w-full items-center justify-center gap-2 rounded-full bg-[#438C38] px-4 py-2 font-heading text-sm font-bold text-white no-underline shadow-[0_6px_16px_-6px_rgba(67,140,56,0.55)] transition-colors hover:bg-[#35732C]"
          >
            <MessageCircle class="size-4 shrink-0" aria-hidden="true" />
            <span>WhatsApp</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header-inner > * {
    flex-shrink: 0;
    white-space: nowrap;
  }

  .site-header .menu-button {
    anchor-name: --menu-button;
  }

  .site-header .site-menu {
    position: fixed;
    inset: auto;
    inset-block-start: 5.5rem;
    inset-block-start: anchor(--menu-button bottom);
    inset-inline-end: 1rem;
    inline-size: min(84dvw, 21rem);
    max-inline-size: calc(100dvw - 2rem);
    block-size: fit-content;
    max-block-size: calc(100dvh - 6.5rem);
    margin-block-start: 0.5rem;
    padding: 0.875rem;
    border-radius: 1.25rem;
    border: 1px solid rgba(67, 86, 58, 0.14);
    background-color: #FFFFFF;
    box-shadow: 0 18px 40px -12px rgba(67, 86, 58, 0.22);
    overflow: auto;
  }

  .site-header .site-menu::backdrop {
    background: rgba(67, 86, 58, 0.28);
    backdrop-filter: blur(2px);
  }

  .site-header .site-menu:not(:is(:popover-open, .\:popover-open)) {
    display: none;
  }

  .site-header .site-menu:is(:popover-open, .\:popover-open) {
    display: grid;
    gap: 0.25rem;
  }

  .site-header .site-menu .nav-link {
    width: 100%;
    justify-content: flex-start;
  }

  .site-header .site-menu .nav-cta-item {
    padding-block-start: 0.5rem;
  }

  .nav-link[aria-current='page'] {
    background-color: #F4FBE9;
    color: #438C38;
    box-shadow: inset 0 -2px 0 0 #438C38;
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header:not(.is-measuring) .site-menu {
      transition:
        opacity 180ms cubic-bezier(0.22, 1, 0.36, 1),
        translate 180ms cubic-bezier(0.22, 1, 0.36, 1),
        display 180ms,
        overlay 180ms;
      transition-behavior: allow-discrete;
    }

    @starting-style {
      .site-header .site-menu:is(:popover-open, .\:popover-open) {
        opacity: 0;
        translate: 0 -6px;
      }
    }
  }

  .site-header.is-wide .menu-button,
  .site-header.is-wide .menu-close-row {
    display: none;
  }

  .site-header.is-wide .site-menu {
    position: static;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    inline-size: auto;
    max-inline-size: none;
    block-size: auto;
    max-block-size: none;
    overflow: visible;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
  }

  .site-header.is-wide .site-menu .nav-link {
    width: auto;
    justify-content: center;
  }

  .site-header.is-wide .site-menu .nav-cta-item {
    padding-block-start: 0;
    margin-inline-start: 0.375rem;
  }

  .site-header.is-wide .site-menu::backdrop {
    display: none;
  }

  .site-header.is-measuring *,
  .site-header.is-measuring .site-menu {
    transition: none !important;
  }

  .site-header.is-measuring .header-inner {
    overflow: hidden;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const inner = header?.querySelector<HTMLElement>('.header-inner');
  const menu = header?.querySelector<HTMLElement>('#site-menu');

  if (header && inner && menu) {
    let lastWidth = inner.clientWidth;

    const updateNavLayout = (forceMeasure = false) => {
      const wasWide = header.classList.contains('is-wide');
      const currentWidth = inner.clientWidth;

      if (!wasWide && !forceMeasure && currentWidth <= lastWidth) {
        lastWidth = currentWidth;
        return;
      }

      const wasOpen =
        menu.matches(':popover-open') || menu.classList.contains(':popover-open');

      header.classList.add('is-measuring');
      header.classList.add('is-wide');
      menu.removeAttribute('popover');

      const fitsInline = inner.scrollWidth <= inner.clientWidth + 1;

      if (fitsInline) {
        header.classList.add('is-wide');
        menu.removeAttribute('popover');
      } else {
        header.classList.remove('is-wide');
        menu.setAttribute('popover', 'auto');
        if (wasOpen && typeof menu.showPopover === 'function') {
          try {
            menu.showPopover();
          } catch {
            // Ignore if already open or unsupported
          }
        }
      }

      lastWidth = currentWidth;
      requestAnimationFrame(() => {
        header.classList.remove('is-measuring');
      });
    };

    // Close popover cleanly when an anchor link inside mobile menu is clicked
    menu.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      const anchor = target?.closest('a');
      if (
        anchor &&
        !header.classList.contains('is-wide') &&
        typeof menu.hidePopover === 'function'
      ) {
        try {
          menu.hidePopover();
        } catch {
          // Ignore
        }
      }
    });

    const observer = new ResizeObserver(() => {
      updateNavLayout(false);
    });

    observer.observe(header);
    observer.observe(menu);
    updateNavLayout(true);
  }
</script>

